{
  "manifest_version": 3,
  "name": "Tempo",
  "version": "1.3.1",
  "description": "Trigger your work automation through Microsoft Power Automate.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.environment.api.powerplatform.com/*",
    "https://*.logic.azure.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Tempo",
    "default_icon": "images/icon.png"
  },
  "icons": {
    "48": "images/icon.png",
    "128": "images/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}